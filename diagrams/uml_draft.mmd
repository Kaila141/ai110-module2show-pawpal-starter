classDiagram
    %% All times are ints: minutes since midnight (8:00 AM = 480)
    %% availableTimeSlots: list of (start, end) tuples
    %% getAllTasks / unscheduledTasks: list of (Pet, Task) tuples
    %% Task.frequency: times per day, entered by the owner
    class Owner {
        +String name
        +List~Pet~ pets
        +List~Tuple~ availableTimeSlots
        +Dict preferences
        +addPet(pet) void
        +setAvailability(slots) void
        +getAllTasks() List~Tuple~
    }

    class Pet {
        +String name
        +String breedSpecies
        +List~Task~ tasks
        +addTask(task) void
        +removeTask(task) void
    }

    class Task {
        +String name
        +int duration
        +Priority priority
        +bool isCompleted
        +int frequency
        +markComplete() void
        +edit(fields) void
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class PlanEntry {
        +Pet pet
        +Task task
        +int start
        +int end
        +String reason
    }

    class Scheduler {
        +Owner owner
        +Date date
        +List~PlanEntry~ entries
        +List~Tuple~ unscheduledTasks
        +String reasoning
        +generatePlan() void
        +sortTasks() List~Tuple~
        +findSlot(duration) int
        +addPlanEntry(pet, task, start, end, reason) bool
        +getTotalDuration() int
        +displayPlan() void
        +explainPlan() String
        +hasOverlap(start, end) bool
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : priority
    Scheduler "1" *-- "0..*" PlanEntry : contains
    PlanEntry --> Pet : for
    PlanEntry --> Task : schedules
    Scheduler --> "1" Owner : plans for
